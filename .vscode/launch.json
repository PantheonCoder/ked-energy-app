{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Start KED Full-Stack (Server + Web)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/start-all.js",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch KED Backend Only",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server/server.js"
    }
  ]
}
