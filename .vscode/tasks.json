{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install KED Dependencies",
      "type": "shell",
      "command": "npm run setup",
      "problemMatcher": []
    },
    {
      "label": "Start KED App",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "focus": false,
        "showReuseMessage": false
      },
      "problemMatcher": {
        "base": "$tsc-watch",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[KED\\] Starting the API and web interface",
          "endsPattern": "http://localhost:5173/"
        }
      }
    }
  ]
}
